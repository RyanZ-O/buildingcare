# Optional LLM service. Configure locally; never put credentials in frontend code.
# LLM_BASE_URL should end at the API root, e.g. https://your-provider.example/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Photo recognition requires a vision-capable model; blank leaves it unavailable.
# URL/key default to the LLM values if omitted. Model must be selected explicitly.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# snapshot runs graph searches on the imported Neo4j CSV without a DB service.
# neo4j executes parameterised Cypher against the imported dataset; failures do not silently fall back.
KNOWLEDGE_BACKEND=snapshot
# For local Community: bolt://127.0.0.1:17687; for Aura: neo4j+s://<instance>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional custom writable data directory. Default: project/data
# MAINTENANCE_DATA_DIR=
